---
import ButtonLink from "~/components/ButtonLink.astro";
import Icon from "~/components/Icon.astro";
import PageHeader from "~/components/PageHeader.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { withBase } from "~/lib/href";

type Talk = { title: string; speaker: string; event?: string; url: string };

const book = {
	title: "Accelerating Server-Side Development with Fastify",
	blurb:
		"A comprehensive guide to API development for building a scalable backend for your web apps.",
	url: "https://www.packtpub.com/product/accelerating-server-side-development-with-fastify/9781800563582",
};

const demo = {
	title: "fastify/demo",
	blurb: "A concrete example of a Fastify application using what the community considers best practices.",
	url: "https://github.com/fastify/demo",
};

const talks: Talk[] = [
	{
		title: "A “fast” Introduction to Fastify",
		speaker: "Matteo Collina",
		event: "NearForm",
		url: "https://www.youtube.com/watch?v=MOvLdfUhqrU",
	},
	{
		title: "Take Your HTTP Server to Ludicrous Speed",
		speaker: "Matteo Collina",
		url: "https://www.youtube.com/watch?v=gltzZjKYK1I",
	},
	{
		title: "Why we built another framework",
		speaker: "Tomas Della Vedova",
		event: "Nordic.js 2018",
		url: "https://www.youtube.com/watch?v=ucatti2b7E4",
	},
	{
		title: "A Fastify Tale of Shapes",
		speaker: "Matteo Collina",
		event: "NearForm",
		url: "https://www.youtube.com/watch?v=g-6Ig8k6Nzc",
	},
	{
		title: "Build a Community, Not a Framework",
		speaker: "Matteo Collina",
		event: "NearForm",
		url: "https://www.youtube.com/watch?v=e0rdy7APH-o",
	},
	{
		title: "1, 2, 3… Fastify!",
		speaker: "Matteo Collina",
		url: "https://www.youtube.com/watch?v=-X84Cq-nsLw",
	},
	{
		title: "Building a modular monolith with Fastify",
		speaker: "Matteo Collina",
		event: "Node Congress 2023",
		url: "https://www.youtube.com/watch?v=e1jkA-ee_aY&t=1s",
	},
	{
		title: "Decoding the Fastify plugin system",
		speaker: "Manuel Spigolon",
		url: "https://www.youtube.com/watch?v=BnnL7fAKqNU",
	},
	{
		title: "Monoliths always pay their debts",
		speaker: "Tomas Della Vedova",
		event: "NodeJS Italian Conference 2018",
		url: "https://www.youtube.com/watch?v=6ucyzQULlWw",
	},
	{
		title: "From mess to mesh using Fastify",
		speaker: "Luca Maraschi",
		event: "NodeConf Remote 2020",
		url: "https://www.youtube.com/watch?v=l3mQfvq07CI",
	},
	{
		title: "Fastify Masterclass",
		speaker: "Matteo Collina",
		event: "2024",
		url: "https://www.youtube.com/watch?v=x3SG71Ut2tA",
	},
];

const channels = [
	{
		label: "GitHub",
		href: "https://github.com/fastify/fastify",
		blurb: "Issues, pull requests, and discussions.",
		icon: "github",
	},
	{
		label: "Discord",
		href: "https://discord.gg/fastify",
		blurb: "Real-time help from the community.",
		icon: "discord",
	},
	{
		label: "Stack Overflow",
		href: "https://stackoverflow.com/questions/tagged/fastify",
		blurb: "Tagged questions and answers.",
		icon: "external",
	},
	{
		label: "X / Twitter",
		href: "https://x.com/fastifyjs",
		blurb: "Releases and ecosystem updates.",
		icon: "external",
	},
];
---

<BaseLayout
  title="Community — Fastify"
  description="Learn Fastify, contribute back, and join the channels where the Fastify community lives."
>
  <PageHeader eyebrow="// community" title="Join the Fastify community">
    Fastify is built and maintained by a friendly, global community. Whether you're here to
    learn, build, or give back, this is where to start.
  </PageHeader>

  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 2xl:max-w-[100rem]">
    <div class="flex items-end justify-between gap-4">
      <div>
        <p class="eyebrow">// resources</p>
        <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight sm:text-4xl">
          Learn Fastify
        </h2>
        <p class="mt-3 max-w-2xl text-lg text-fg-soft">
          Curated reading, code, and talks to get you from “what is Fastify?” to shipping
          production APIs on it.
        </p>
      </div>
    </div>

    <div class="mt-10 grid gap-4 lg:grid-cols-2">
      <article class="card flex flex-col gap-4 p-6 sm:p-8">
        <div class="flex items-center gap-2">
          <span class="font-mono text-xs uppercase tracking-[0.18em] text-amber-ink">[book]</span>
        </div>
        <h3 class="font-display text-xl font-semibold">{book.title}</h3>
        <p class="text-fg-soft">{book.blurb}</p>
        <div class="mt-auto">
          <ButtonLink href={book.url} external>
            Read on Packt <Icon name="external" size={16} />
          </ButtonLink>
        </div>
      </article>

      <article class="card flex flex-col gap-4 p-6 sm:p-8">
        <div class="flex items-center gap-2">
          <span class="font-mono text-xs uppercase tracking-[0.18em] text-amber-ink">[demo]</span>
        </div>
        <h3 class="font-mono text-xl font-semibold">{demo.title}</h3>
        <p class="text-fg-soft">{demo.blurb}</p>
        <div class="mt-auto">
          <ButtonLink href={demo.url} external>
            <Icon name="github" size={16} /> Browse the repo
          </ButtonLink>
        </div>
      </article>
    </div>

    <div class="mt-10">
      <div class="flex items-center gap-3">
        <span class="font-mono text-xs uppercase tracking-[0.18em] text-amber-ink">[talks]</span>
        <p class="eyebrow">// watch &amp; learn</p>
      </div>
      <h3 class="mt-3 font-display text-2xl font-semibold">Talks from the team</h3>
      <p class="mt-3 max-w-2xl text-fg-soft">
        Conference talks and deep dives from the people building Fastify.
      </p>
      <ul class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          talks.map((talk) => (
            <li>
              <a
                href={talk.url}
                target="_blank"
                rel="noopener noreferrer"
                class="card group flex h-full flex-col gap-2 p-5 transition-colors hover:border-border-strong"
              >
                <div class="flex items-start justify-between gap-2">
                  <h4 class="font-display text-base font-semibold leading-snug">
                    {talk.title}
                  </h4>
                  <Icon
                    name="external"
                    size={14}
                    class="shrink-0 text-muted opacity-0 transition-opacity group-hover:opacity-100"
                  />
                </div>
                <p class="font-mono text-xs text-muted">{talk.speaker}</p>
                {talk.event && (
                  <p class="text-xs text-muted">{talk.event}</p>
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="border-t border-border bg-telemetry/40">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 2xl:max-w-[100rem]">
      <div class="flex items-end justify-between gap-4">
        <div>
          <p class="eyebrow">// contribute</p>
          <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight sm:text-4xl">
            Give back to Fastify
          </h2>
          <p class="mt-3 max-w-2xl text-lg text-fg-soft">
            Bug fixes, docs, plugins, talks — every contribution shapes the framework. Start by
            reading the contribution guidelines, then pick an issue below.
          </p>
        </div>
      </div>

      <div class="mt-10 grid gap-4 sm:grid-cols-2">
        <a
          href="https://github.com/fastify/fastify/blob/main/CONTRIBUTING.md"
          target="_blank"
          rel="noopener noreferrer"
          class="card group flex items-center justify-between gap-4 p-5 transition-colors hover:border-border-strong"
        >
          <div>
            <p class="font-mono text-xs uppercase tracking-[0.18em] text-amber-ink">[guidelines]</p>
            <h3 class="mt-2 font-display text-lg font-semibold">Contribution Guidelines</h3>
            <p class="mt-1 text-sm text-fg-soft">How we work, review, and ship together.</p>
          </div>
          <Icon name="arrow" size={18} class="text-muted transition-transform group-hover:translate-x-0.5" />
        </a>
        <a
          href="https://github.com/fastify/fastify/blob/main/CODE_OF_CONDUCT.md"
          target="_blank"
          rel="noopener noreferrer"
          class="card group flex items-center justify-between gap-4 p-5 transition-colors hover:border-border-strong"
        >
          <div>
            <p class="font-mono text-xs uppercase tracking-[0.18em] text-amber-ink">[conduct]</p>
            <h3 class="mt-2 font-display text-lg font-semibold">Code of Conduct</h3>
            <p class="mt-1 text-sm text-fg-soft">The norms that keep the community welcoming.</p>
          </div>
          <Icon name="arrow" size={18} class="text-muted transition-transform group-hover:translate-x-0.5" />
        </a>
      </div>

      <div class="mt-10">
        <div class="flex items-center gap-3">
          <span class="font-mono text-xs uppercase tracking-[0.18em] text-amber-ink">[good first issues]</span>
          <p class="eyebrow">// a great place to start</p>
        </div>
        <h3 class="mt-3 font-display text-2xl font-semibold">Open issues across the org</h3>
        <p class="mt-3 max-w-2xl text-fg-soft">
          Pulled live from GitHub, filtered to issues labelled
          <span class="font-mono text-amber-ink">good first issue</span> across the
          <span class="font-mono text-amber-ink">fastify</span> organisation.
        </p>

        <div
          data-good-first-issues
          data-org="fastify"
          class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3"
        >
          <p data-good-first-issues-empty class="col-span-full py-8 text-center text-muted">
            Loading issues…
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 2xl:max-w-[100rem]">
    <p class="eyebrow">// channels</p>
    <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight sm:text-4xl">
      Where the community lives
    </h2>
    <p class="mt-3 max-w-2xl text-lg text-fg-soft">
      Pick whichever channel fits the question.
    </p>
    <ul class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {
        channels.map((c) => (
          <li>
            <a
              href={c.href}
              target="_blank"
              rel="noopener noreferrer"
              class="card group flex h-full flex-col gap-3 p-5 transition-colors hover:border-border-strong"
            >
              <div class="flex items-center gap-2">
                <Icon name={c.icon} size={18} class="text-amber-ink" />
                <span class="font-display text-base font-semibold">{c.label}</span>
              </div>
              <p class="text-sm text-fg-soft">{c.blurb}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-24 sm:px-6 2xl:max-w-[100rem]">
    <div
      class="relative overflow-hidden rounded-2xl border border-border bg-telemetry px-6 py-14 text-center sm:px-12"
    >
      <div class="pointer-events-none absolute inset-x-0 top-0 h-64 glow-amber"></div>
      <div class="relative">
        <p class="eyebrow">// ship something</p>
        <h2 class="mx-auto mt-4 max-w-2xl font-display text-3xl font-semibold tracking-tight sm:text-4xl">
          Ready to <span class="text-velocity">build</span>?
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-lg text-fg-soft">
          Start with the guide, or jump straight into the API reference.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <ButtonLink href={withBase("/docs/latest/Guides/Getting-Started/")} size="lg">
            Get started <Icon name="arrow" size={18} />
          </ButtonLink>
          <ButtonLink href="https://github.com/fastify/fastify" variant="secondary" size="lg" external>
            <Icon name="github" size={18} /> Open an issue
          </ButtonLink>
        </div>
      </div>
    </div>
  </section>

  <script>
    type Issue = { title: string; html_url: string; repository_url: string };

    const grid = document.querySelector<HTMLElement>('[data-good-first-issues]');
    if (grid) {
      const org = grid.dataset.org ?? 'fastify';
      const cacheKey = `fastify-good-first-issues:${org}`;
      const cached = sessionStorage.getItem(cacheKey);

      const render = (issues: Issue[]) => {
        grid.innerHTML = '';
        if (!issues.length) {
          const none = document.createElement('p');
          none.className = 'col-span-full py-8 text-center text-muted';
          none.textContent = 'No open good first issues right now — check back soon.';
          grid.appendChild(none);
          return;
        }
        for (const issue of issues) {
          const repo = issue.repository_url.split('/').slice(-2).join('/');
          const a = document.createElement('a');
          a.href = issue.html_url;
          a.target = '_blank';
          a.rel = 'noopener noreferrer';
          a.className =
            'card group flex h-full flex-col gap-2 p-5 transition-colors hover:border-border-strong';
          a.innerHTML = `
            <p class="font-mono text-xs text-muted">${repo}</p>
            <h4 class="font-display text-base font-semibold leading-snug text-fg">${issue.title}</h4>
          `;
          grid.appendChild(a);
        }
      };

      if (cached) {
        try {
          render(JSON.parse(cached));
        } catch (e) {
          sessionStorage.removeItem(cacheKey);
        }
      } else {
        const url = `https://api.github.com/search/issues?q=label:"good%20first%20issue"+is:open+is:issue+org:${org}&sort=created&order=desc&per_page=9`;
        fetch(url, { headers: { Accept: 'application/vnd.github+json' } })
          .then((res) => (res.ok ? res.json() : Promise.reject(res.status)))
          .then((data) => {
            const issues: Issue[] = Array.isArray(data?.items) ? data.items : [];
            try { sessionStorage.setItem(cacheKey, JSON.stringify(issues)); } catch (e) {}
            render(issues);
          })
          .catch(() => {
            const empty = grid.querySelector<HTMLElement>('[data-good-first-issues-empty]');
            if (!empty) return;
            empty.textContent = 'Unable to load issues right now. Try GitHub directly.';
            const link = document.createElement('a');
            link.href = `https://github.com/search?q=label%3A%22good%20first%20issue%22+is%3Aopen+is%3Aissue+org%3A${org}&type=issues`;
            link.target = '_blank';
            link.rel = 'noopener noreferrer';
            link.className =
              'ml-2 text-amber-ink underline decoration-border-strong underline-offset-2';
            link.textContent = 'Open the search on GitHub ↗';
            empty.appendChild(link);
          });
      }
    }
  </script>
</BaseLayout>