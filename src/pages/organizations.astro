---
import ButtonLink from "~/components/ButtonLink.astro";
import Icon from "~/components/Icon.astro";
import OrganizationLogo from "~/components/OrganizationLogo.astro";
import PageHeader from "~/components/PageHeader.astro";
import { SITE, SPONSORS } from "~/data/site";
import BaseLayout from "~/layouts/BaseLayout.astro";

const collaborator = SPONSORS.filter((s) => s.tier === "collaborator");

// Highest tiers first so the "pixel size we sell" reads big-to-small.
const tierRank = { tier_4: 0, tier_3: 1, collaborator: 2 } as const;
const sponsors = SPONSORS.filter((s) => s.tier !== "collaborator").sort(
	(a, b) => tierRank[a.tier] - tierRank[b.tier],
);
---

<BaseLayout
  title="Organizations — Fastify"
  description="Organizations using Fastify and sponsors."
>
  <PageHeader eyebrow="// who is using fastify" title="Organizations">
    Fastify proudly powers a large ecosystem of organizations and products,
    with over{" "}
    <span data-npm-downloads>{SITE.downloads}</span> downloads per month.
  </PageHeader>

  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 2xl:max-w-[100rem]">
    <p class="eyebrow">// collaborators</p>
    <h2 class="mt-3 font-display text-2xl font-semibold">
      Collaborators' organizations
    </h2>
    <p class="mt-3 max-w-xl text-fg-soft">
      Companies backed by Fastify collaborators, running it in production.
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-4">
      {collaborator.map((c) => <OrganizationLogo sponsor={c} />)}
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 2xl:max-w-[100rem]">
    <div
      class="card flex flex-col items-start gap-6 p-8 sm:flex-row sm:items-center sm:justify-between"
    >
      <div>
        <p class="eyebrow">// sponsors</p>
        <h2 class="mt-3 font-display text-2xl font-semibold">
          Kindly sponsored by
        </h2>
        <p class="mt-3 max-w-md text-fg-soft">
          Financial supporters keep Fastify fast and free. Logo size scales with
          the sponsorship tier.
        </p>
      </div>
      <div class="flex flex-wrap gap-3">
        <ButtonLink href="https://github.com/sponsors/fastify" external>
          <Icon name="github" size={18} /> Sponsor
        </ButtonLink>
        <ButtonLink
          href="https://opencollective.com/fastify"
          variant="secondary"
          external
        >
          Open Collective
        </ButtonLink>
      </div>
    </div>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      {sponsors.map((s) => <OrganizationLogo sponsor={s} />)}
    </div>

    <p class="mt-8 text-center font-mono text-xs text-muted">
      Logos are property of their respective organizations and are not covered by
      the Fastify (MIT) license.
    </p>
  </section>
</BaseLayout>
