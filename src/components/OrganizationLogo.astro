---
import type { Sponsor } from "~/data/site";
import { withBase } from "~/lib/href";

interface Props {
  sponsor: Sponsor;
  /**
   * `tier` sizes the logo by sponsorship tier (used on the organizations page,
   * where we "sell pixel size"); `marquee` renders every logo at one size.
   */
  variant?: "tier" | "marquee";
  class?: string;
}

const { sponsor, variant = "tier", class: className } = Astro.props;

// Higher tiers earn a bigger footprint. Sizes are bounding boxes so logos of any
// aspect ratio stay balanced via object-contain.
const TILE_PADDING: Record<Sponsor["tier"], string> = {
  tier_4: "px-8 py-7",
  tier_3: "px-6 py-5",
  collaborator: "px-6 py-5",
};

const LOGO_SIZE: Record<Sponsor["tier"], string> = {
  tier_4: "h-14 max-w-[240px]",
  tier_3: "h-10 max-w-[190px]",
  collaborator: "h-10 max-w-[190px]",
};

const padding =
  variant === "marquee" ? "px-5 py-3" : TILE_PADDING[sponsor.tier];
const logoSize =
  variant === "marquee" ? "h-7 max-w-[150px]" : LOGO_SIZE[sponsor.tier];
---

<a
  href={sponsor.url}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={sponsor.name}
  class:list={[
    "group inline-flex items-center justify-center rounded-lg ring-1 transition duration-300 ease-out-expo hover:-translate-y-0.5",
    // Light: colored logo on a white plate (kept as-is).
    "bg-white shadow-sm ring-black/5 hover:ring-black/10",
    // Dark: swap the white bubble for a subtle surface chip so logos read as
    // part of the portal's card system.
    "dark:bg-surface dark:shadow-none dark:ring-border dark:hover:bg-surface-2 dark:hover:ring-border-strong",
    padding,
    className,
  ]}
>
  <img
    src={withBase(`/organizations/${sponsor.image}`)}
    alt={sponsor.name}
    loading="lazy"
    decoding="async"
    class:list={[
      "w-auto object-contain transition duration-300 ease-out-expo group-hover:scale-[1.04]",
      logoSize,
      // Photon ships a white logo; invert it so it reads on the light plate.
      sponsor.invert && "filter-[invert(1)]",
      // Dark: normalise every logo to a soft monochrome silhouette so no white
      // plate is needed behind it.
      "dark:opacity-80 dark:filter-[brightness(0)_invert(1)] dark:group-hover:opacity-100",
    ]}
  />
</a>
